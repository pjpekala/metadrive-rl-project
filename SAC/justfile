# MetaDrive SAC Training - Justfile
# Quick commands for training and evaluation using uv
#
# Quick examples:
#   just train-bev
#   just train-bev --total-timesteps 500000
#   just train-rgb --n-envs 2 --buffer-size 150000 --batch-size 512 --learning-starts 10000 --train-freq 8 --gradient-steps 4 --learning-rate 0.0001 --vec-env subproc --memory-budget-gb 50
#   just train-bev --no-inline-eval
#   just eval-bev --episodes 20
#   just eval-rgb --render --save-video

# === SETUP ===

# Install dependencies using uv
setup:
    @echo "[+] Installing dependencies with uv..."
    uv pip install -e .
    uv pip install metadrive-simulator stable-baselines3 tensorboard imageio imageio-ffmpeg
    @echo "[+] Setup complete!"

# === TRAINING ===

# Train Sparse LiDAR model
train-sparse *ARGS:
    uv run python train_metadrive.py \
        --modality sparse_lidar \
        --total-timesteps 1000000 \
        --n-envs 8 \
        --device cuda \
        {{ ARGS }}

# Train Dense LiDAR model
train-dense *ARGS:
    uv run python train_metadrive.py \
        --modality dense_lidar \
        --total-timesteps 1000000 \
        --n-envs 8 \
        --device cuda \
        {{ ARGS }}

# Train BEV (Bird's Eye View) model
train-bev *ARGS:
    uv run python train_metadrive.py \
        --modality bev \
        --total-timesteps 2000000 \
        --n-envs 1 \
        --buffer-size 80000 \
        --learning-starts 8000 \
        --batch-size 128 \
        --train-freq 4 \
        --gradient-steps 2 \
        --learning-rate 0.0001 \
        --vec-env dummy \
        --device cuda \
        --memory-budget-gb 12 \
        --no-inline-eval \
        {{ ARGS }}

# Train RGB Camera model
train-rgb *ARGS:
    uv run python train_metadrive.py \
        --modality rgb \
        --total-timesteps 1000000 \
        --n-envs 1 \
        --buffer-size 40000 \
        --learning-starts 3000 \
        --batch-size 128 \
        --train-freq 8 \
        --gradient-steps 2 \
        --learning-rate 0.0001 \
        --vec-env dummy \
        --device cuda \
        --memory-budget-gb 12 \
        --no-inline-eval \
        {{ ARGS }}

# Train all modalities (in sequence)
train-all:
    just train-sparse
    just train-dense
    just train-bev
    just train-rgb

# === EVALUATION ===

# Evaluate Sparse LiDAR model
eval-sparse *ARGS:
    uv run python evaluate_metadrive.py \
        --model-path ./models/sparse_lidar/sac_metadrive_final.zip \
        --modality sparse_lidar \
        {{ ARGS }}

# Evaluate Dense LiDAR model
eval-dense *ARGS:
    uv run python evaluate_metadrive.py \
        --model-path ./models/dense_lidar/sac_metadrive_final.zip \
        --modality dense_lidar \
        {{ ARGS }}

# Evaluate BEV model
eval-bev *ARGS:
    uv run python evaluate_metadrive.py \
        --model-path ./models/bev/sac_metadrive_final.zip \
        --modality bev \
        {{ ARGS }}

# Evaluate RGB model
eval-rgb *ARGS:
    uv run python evaluate_metadrive.py \
        --model-path ./models/rgb/sac_metadrive_final.zip \
        --modality rgb \
        {{ ARGS }}

# === TENSORBOARD ===

# Launch TensorBoard for Sparse LiDAR
tb-sparse:
    uv run tensorboard --logdir ./models/sparse_lidar/logs

# Launch TensorBoard for Dense LiDAR
tb-dense:
    uv run tensorboard --logdir ./models/dense_lidar/logs

# Launch TensorBoard for BEV
tb-bev:
    uv run tensorboard --logdir ./models/bev/logs

# Launch TensorBoard for RGB
tb-rgb:
    uv run tensorboard --logdir ./models/rgb/logs

# Launch TensorBoard for all logs
tb-all:
    uv run tensorboard --logdir ./models

# === UTILITIES ===

# Clean training artifacts (models, logs, checkpoints)
clean:
    @echo "[!] Cleaning training artifacts..."
    rm -rf ./models/*/logs
    rm -rf ./models/*/checkpoints
    rm -f ./models/*/replay_buffer.pkl
    @echo "[+] Clean complete! Models preserved."

# Clean everything including trained models
clean-all:
    @echo "[!] Cleaning all artifacts including models..."
    rm -rf ./models
    @echo "[+] All artifacts removed!"

# List available trained models
list-models:
    @echo "Available trained models:"
    @find ./models -name "*.zip" -type f 2>/dev/null | head -20 || echo "No models found."

# Show help
help:
    @echo "MetaDrive SAC Training - Available Commands:"
    @echo ""
    @echo "Setup:"
    @echo "  just setup              - Install dependencies with uv"
    @echo ""
    @echo "Training (optional ARGS for extra parameters):"
    @echo "  just train-sparse       - Train Sparse LiDAR (80 beams)"
    @echo "  just train-dense        - Train Dense LiDAR (240 beams)"
    @echo "  just train-bev          - Train BEV (top-down view)"
    @echo "  just train-rgb          - Train RGB Camera"
    @echo "  just train-all          - Train all modalities sequentially"
    @echo ""
    @echo "Evaluation (optional ARGS for --render, --save-video, etc.):"
    @echo "  just eval-sparse        - Evaluate Sparse LiDAR"
    @echo "  just eval-dense         - Evaluate Dense LiDAR"
    @echo "  just eval-bev           - Evaluate BEV"
    @echo "  just eval-rgb           - Evaluate RGB"
    @echo ""
    @echo "TensorBoard:"
    @echo "  just tb-sparse          - Launch TensorBoard for Sparse LiDAR"
    @echo "  just tb-dense           - Launch TensorBoard for Dense LiDAR"
    @echo "  just tb-bev             - Launch TensorBoard for BEV"
    @echo "  just tb-rgb             - Launch TensorBoard for RGB"
    @echo "  just tb-all             - Launch TensorBoard for all logs"
    @echo ""
    @echo "Utilities:"
    @echo "  just clean              - Remove logs and checkpoints (keep models)"
    @echo "  just clean-all          - Remove everything including models"
    @echo "  just list-models        - List available trained models"
    @echo ""
    @echo "Examples:"
    @echo "  just train-sparse --total-timesteps 500000"
    @echo "  just eval-sparse --render --save-video"
    @echo "  just train-rgb --n-envs 2 --buffer-size 150000 --batch-size 512 --learning-starts 10000 --train-freq 8 --gradient-steps 4 --learning-rate 0.0001 --vec-env subproc --memory-budget-gb 50"
